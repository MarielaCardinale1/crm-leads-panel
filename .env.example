# Copiá este archivo como .env (no se sube al repo) y completá con tu proyecto Firebase.
# Firebase Console > Configuración del proyecto > Tus apps (app web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_APP_ID=""
# URL base de las Cloud Functions (región us-central1)
VITE_FUNCTIONS_BASE_URL="https://us-central1-tu-proyecto.cloudfunctions.net"
# Emails que pueden entrar (separados por coma). El servidor también lo valida.
VITE_ADMIN_EMAILS="tu-email@gmail.com"
