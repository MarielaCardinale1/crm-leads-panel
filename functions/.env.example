# Copiá este archivo como functions/.env (no se sube al repo).
# Emails que pueden usar el panel (separados por coma)
ALLOWED_EMAILS="tu-email@gmail.com"
# Orígenes web que pueden llamar a las funciones (panel de leads y tablero)
ALLOWED_ORIGINS="https://tu-sitio-leads.web.app,http://localhost:3000"
# Ofertas activas: un lead con una de estas ofertas suma puntos por buen encaje
ACTIVE_OFFERS="Agenda Online"
# Módulos que se despliegan (separados por coma): copy, seguimientos, redes, prospector. Vacío = todos.
# Los apagados no se despliegan ni crean tareas programadas. Tiene que coincidir con VITE_FEATURES del .env de la raíz.
FEATURES=""
# Id de la cuenta de Instagram (solo si usás "redes")
IG_USER_ID=""
